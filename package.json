{
  "name": "@naturalth2012/middle-earth-atlas",
  "version": "1.0.0",
  "description": "A canon-aware atlas of The Lord of the Rings: 56 characters, 205 relationships, an interactive graph with quantitative network analysis, a 33-event timeline, 27 places, 14 artifacts, 40 quotes, 7 thematic dialectics, book-vs-screen differences, and 14 playable avatar journeys with a spoiler-aware reading gate — in a side panel and through ten agent tools.",
  "type": "module",
  "license": "MIT",
  "author": "naturalth2012",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tolkien",
    "lord-of-the-rings",
    "middle-earth",
    "knowledge-graph",
    "silmarillion",
    "rings-of-power",
    "interactive-fiction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturalth2012/middle-earth-atlas.git"
  },
  "homepage": "https://github.com/naturalth2012/middle-earth-atlas#readme",
  "bugs": {
    "url": "https://github.com/naturalth2012/middle-earth-atlas/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node scripts/selfcheck.mjs",
    "check": "node scripts/selfcheck.mjs && node scripts/inline-avatar-tab.mjs --check && npm run probe",
    "probe": "node scripts/probe.mjs && node scripts/probe-drawer.mjs && node scripts/probe-storage.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./engine": "./engine.js",
    "./data": "./data.js",
    "./lore": "./lore.js",
    "./journey": "./journey.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./storage": "./storage.js",
    "./validate-source": "./validate-source.js",
    "./spoiler": "./spoiler.js",
    "./themes": "./themes.js",
    "./analysis": "./analysis.js"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.js",
    "data.js",
    "lore.js",
    "journey.js",
    "avatar-tab.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/PUBLISHING.md",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/selfcheck.mjs",
    "scripts/probe.mjs",
    "scripts/probe-drawer.mjs",
    "scripts/inline-avatar-tab.mjs",
    "storage.js",
    "scripts/probe-storage.mjs",
    "validate-source.js",
    "docs/AUDIT.md",
    "docs/PLAN-ATMOSPHERE.md",
    "docs/PLAN-P0.md",
    "docs/ROADMAP.md",
    "spoiler.js",
    "themes.js",
    "analysis.js",
    "docs/PLAN-SPOILER.md",
    "docs/ANALYSIS-THREE-BODY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
