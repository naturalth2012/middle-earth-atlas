{
  "name": "@naturalth2012/middle-earth-atlas",
  "version": "1.0.0",
  "description": "中土与精灵宝钻全景：68 位人物与 236 条关系图谱、46 个纪元事件、33 个地点、14 件宝物、剧情脉络、术语名句、改编差异与 7 组主题辩证；可运行的力导向图谱与中心性分析、阅读进度视图，以及 17 位可扮演角色的剧情旅程（含剧透分级与进度存档）。侧边栏面板与 12 个对话工具共用同一套数据，全部视图可按剧透层级遮蔽。",
  "type": "module",
  "license": "MIT",
  "author": "naturalth2012",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tolkien",
    "lord-of-the-rings",
    "middle-earth",
    "knowledge-graph",
    "silmarillion",
    "rings-of-power",
    "interactive-fiction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naturalth2012/middle-earth-atlas.git"
  },
  "homepage": "https://github.com/naturalth2012/middle-earth-atlas#readme",
  "bugs": {
    "url": "https://github.com/naturalth2012/middle-earth-atlas/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node scripts/selfcheck.mjs",
    "check": "node scripts/selfcheck.mjs && node scripts/inline-avatar-tab.mjs --check && npm run probe",
    "probe": "node scripts/probe.mjs && node scripts/probe-drawer.mjs && node scripts/probe-storage.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./engine": "./engine.js",
    "./data": "./data.js",
    "./lore": "./lore.js",
    "./journey": "./journey.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./storage": "./storage.js",
    "./validate-source": "./validate-source.js",
    "./spoiler": "./spoiler.js",
    "./themes": "./themes.js",
    "./analysis": "./analysis.js",
    "./progress": "./progress.js"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.js",
    "data.js",
    "lore.js",
    "journey.js",
    "avatar-tab.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/PUBLISHING.md",
    "icon.svg",
    "README.md",
    "LICENSE",
    "scripts/selfcheck.mjs",
    "scripts/probe.mjs",
    "scripts/probe-drawer.mjs",
    "scripts/inline-avatar-tab.mjs",
    "storage.js",
    "scripts/probe-storage.mjs",
    "validate-source.js",
    "docs/AUDIT.md",
    "docs/PLAN-ATMOSPHERE.md",
    "docs/PLAN-P0.md",
    "docs/ROADMAP.md",
    "spoiler.js",
    "themes.js",
    "analysis.js",
    "docs/PLAN-SPOILER.md",
    "docs/ANALYSIS-THREE-BODY.md",
    "progress.js",
    "docs/PLAN-CONTENT-AND-PROGRESS.md",
    "docs/PLAN-READING-PROGRESS.md",
    "docs/DIAGNOSIS-IN-PROGRESS.md",
    "docs/ANALYSIS-READING-PROGRESS.md",
    "market-entry.yml",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
